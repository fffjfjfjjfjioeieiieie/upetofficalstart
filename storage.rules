rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function validAsset(fileName) {
      return (fileName.matches('^(avatar|cursor|cover)-[a-zA-Z0-9-]+\\.[a-z0-9]+$')
        && request.resource.contentType.matches('image/.*')
        && request.resource.size <= 5 * 1024 * 1024)
        || (fileName.matches('^(banner|image)-[a-zA-Z0-9-]+\\.[a-z0-9]+$')
        && request.resource.contentType.matches('image/.*')
        && request.resource.size <= 10 * 1024 * 1024)
        || (fileName.matches('^audio-[a-zA-Z0-9-]+\\.[a-z0-9]+$')
        && request.resource.contentType.matches('audio/.*')
        && request.resource.size <= 20 * 1024 * 1024)
        || (fileName.matches('^click-[a-zA-Z0-9-]+\\.[a-z0-9]+$')
        && request.resource.contentType.matches('audio/.*')
        && request.resource.size <= 5 * 1024 * 1024)
        || (fileName.matches('^(background|video)-[a-zA-Z0-9-]+\\.[a-z0-9]+$')
        && request.resource.contentType.matches('(image|video)/.*')
        && request.resource.size <= 100 * 1024 * 1024);
    }
    match /profiles/{uid}/{fileName} {
      allow get: if true;
      allow list: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && validAsset(fileName);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
