rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /visitorSessions/{id} { allow read, write: if false; }
    match /visitorDiagnostics/{id} { allow read, write: if false; }
    match /visitorAudit/{id} { allow read, write: if false; }
    match /visitorRateLimits/{id} { allow read, write: if false; }
    match /visitorClaims/{id} { allow read, write: if false; }
    match /visitorDaily/{id} { allow read, write: if false; }
    match /uploadQuotas/{id} { allow read, write: if false; }
    match /visitorLive/{id} { allow read, write: if false; }
    // Retired commerce data remains private. No records are deleted.
    match /shopAdminProducts/{id} { allow read, write: if false; }
    match /shopAdminSettings/{id} { allow read, write: if false; }
    match /shopAdminAudit/{id} { allow read, write: if false; }
    match /shopAdminSlugs/{id} { allow read, write: if false; }
    match /shopAuthCodes/{id} { allow read, write: if false; }
    match /shopOrders/{id} { allow read, write: if false; }
    match /shopEvents/{id} { allow read, write: if false; }
    match /shopAdminMessages/{id} { allow read, write: if false; }
    match /shopDiscounts/{id} { allow read, write: if false; }
    match /shopReviews/{id} { allow read, write: if false; }
    match /shopNotifications/{id} { allow read, write: if false; }
    match /shopStripeEvents/{id} { allow read, write: if false; }
    match /shopSubscriptions/{id} { allow read, write: if false; }
    match /shopProductFiles/{id} { allow read, write: if false; }
    match /shopBuyerStates/{id} { allow read, write: if false; }
    function signedIn() {
      return request.auth != null;
    }

    function hasTrustedRole(role) {
      return signedIn()
        && ((request.auth.token.get('role', '') is string && request.auth.token.get('role', '') == role)
          || (request.auth.token.get('roles', []) is list && role in request.auth.token.get('roles', []))
          || (role == 'founder' && request.auth.token.get('founder', false) == true)
          || (role == 'admin' && request.auth.token.get('admin', false) == true)
          || (role == 'moderator' && request.auth.token.get('moderator', false) == true)
          || (role == 'support' && request.auth.token.get('support', false) == true));
    }

    function founder() {
      return hasTrustedRole('founder');
    }

    function siteMember() {
      return founder() || (signedIn()
        && request.auth.token.email is string
        && exists(/databases/$(database)/documents/accessInvites/$(request.auth.token.email))
        && get(/databases/$(database)/documents/accessInvites/$(request.auth.token.email)).data.active == true
        && get(/databases/$(database)/documents/accessInvites/$(request.auth.token.email)).data.role == 'member');
    }

    function supportMembership() {
      return get(/databases/$(database)/documents/supportStaff/$(request.auth.uid)).data;
    }

    function supportStaff() {
      return signedIn()
        && (hasTrustedRole('founder')
          || hasTrustedRole('admin')
          || hasTrustedRole('moderator')
          || hasTrustedRole('support'))
        && exists(/databases/$(database)/documents/supportStaff/$(request.auth.uid))
        && supportMembership().active == true
        && supportMembership().role in ['owner', 'support_admin', 'support_agent', 'moderator'];
    }

    function supportOwner() {
      return supportStaff() && supportMembership().role == 'owner';
    }

    function profileVisible(username) {
      return !exists(/databases/$(database)/documents/moderationProfiles/$(username))
        || get(/databases/$(database)/documents/moderationProfiles/$(username)).data.status != 'restricted';
    }

    function validUsername(username) {
      return username is string
        && username.matches('^[a-z0-9][a-z0-9._-]{2,19}$')
        && !(username in ['dashboard', 'business', 'business-verification', 'biz', 'customize', 'analytics', 'settings', 'claim', 'welcome', 'create-account', 'login', 'admin', 'api', 'assets'])
        && (username != 'dome' || founder());
    }

    match /profileRankingStats/{username} {
      allow read, write: if false;
    }

    match /usernames/{username} {
      // Public availability checks are allowed; enumerating all handles is not.
      allow get: if siteMember();
      allow list: if false;

      // A claim and its account profile must be created together in one transaction.
      allow create: if siteMember()
        && validUsername(username)
        && request.resource.data.keys().hasOnly(['uid', 'username', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'username', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;

      // Handles are permanent; clients cannot transfer or delete them.
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow get: if siteMember() && request.auth.uid == uid;
      allow list: if false;

      allow create: if siteMember()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'role', 'username', 'createdAt', 'updatedAt', 'usernameChangedAt'])
        && request.resource.data.keys().hasAll(['uid', 'email', 'role', 'username', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == (founder() ? 'founder' : 'member')
        && validUsername(request.resource.data.username)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;

      // Owners may repair legacy account metadata, but cannot transfer a handle.
      allow update: if siteMember()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'role', 'username', 'createdAt', 'updatedAt', 'usernameChangedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.username == resource.data.username
        && request.resource.data.createdAt == resource.data.get('createdAt', request.time)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.updatedAt == request.time
        && get(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;
      allow delete: if false;
    }

    match /profiles/{username} {
      // Drafts now live in owner-only profileDrafts. Legacy documents that still
      // contain a draft stay private until their owner republishes them.
      allow get: if (profileVisible(username)
          && (!exists(/databases/$(database)/documents/profiles/$(username)) || !('draft' in resource.data)))
        || (founder() && (resource.data.get('ownerUid', '') == request.auth.uid || resource.data.get('uid', '') == request.auth.uid));
      allow list: if false;

      allow create: if siteMember()
        && profileVisible(username)
        && validUsername(username)
        && request.resource.data.keys().hasOnly(['schemaVersion', 'ownerUid', 'username', 'status', 'published', 'publishedAt', 'updatedAt', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.username == username
        && request.resource.data.status == 'published'
        && request.resource.data.schemaVersion == 1
        && request.resource.data.published.schemaVersion == 1
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;

      allow update: if siteMember()
        && profileVisible(username)
        && (resource.data.get('ownerUid', '') == request.auth.uid || resource.data.get('uid', '') == request.auth.uid)
        && request.resource.data.keys().hasOnly(['schemaVersion', 'ownerUid', 'username', 'status', 'published', 'publishedAt', 'updatedAt', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.username == username
        && request.resource.data.status == 'published'
        && request.resource.data.schemaVersion == 1
        && request.resource.data.published.schemaVersion == 1
        && request.resource.data.updatedAt == request.time
        && (!('updatedAt' in resource.data) || request.time >= resource.data.updatedAt + duration.value(1, 's'))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;

      allow delete: if false;
    }

    match /profileDrafts/{uid} {
      allow get: if siteMember() && request.auth.uid == uid;
      allow list: if false;
      allow create, update: if siteMember()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['schemaVersion', 'ownerUid', 'username', 'document', 'updatedAt'])
        && request.resource.data.ownerUid == uid
        && request.resource.data.username == get(/databases/$(database)/documents/users/$(uid)).data.username
        && request.resource.data.schemaVersion == 1
        && request.resource.data.document.schemaVersion == 1;
      allow delete: if siteMember() && request.auth.uid == uid;
    }

    match /profileEvents/{username}/events/{eventId} {
      allow get: if siteMember()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;
      allow list: if siteMember()
        && request.query.limit != null
        && request.query.limit <= 101
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;
      // Profile events now enter through the trusted, rate-limited API so
      // ranking aggregates and deduplication stay in the same transaction.
      allow create: if false;
      allow update, delete: if false;
    }

    match /profileRevisions/{username}/revisions/{revisionId} {
      allow get: if siteMember()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;
      allow list: if siteMember()
        && request.query.limit != null
        && request.query.limit <= 51
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;
      allow create: if siteMember()
        && request.resource.data.keys().hasOnly(['schemaVersion', 'ownerUid', 'username', 'document', 'publishedAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.username == username
        && request.resource.data.schemaVersion == 1
        && request.resource.data.document.schemaVersion == 1
        && getAfter(/databases/$(database)/documents/profiles/$(username)).data.ownerUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Retired commerce records are retained, not exposed to browser clients.
    match /shopMessages/{id} { allow read, write: if false; }
    match /shopConversations/{id}/{document=**} { allow read, write: if false; }

    match /directoryProfiles/{username} {
      // Restricted profiles are removed from this collection by modview.
      allow get: if true;
      allow list: if request.query.limit != null && request.query.limit <= 60;
      allow create, update: if siteMember()
        && profileVisible(username)
        && validUsername(username)
        && request.resource.data.keys().hasOnly(['ownerUid', 'username', 'displayName', 'alias', 'avatar', 'badges', 'shop', 'updatedAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.username == username
        && request.resource.data.updatedAt == request.time
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;
      allow delete: if false;
    }

    function validBusinessApplication(data) {
      return data.keys().hasOnly(['ownerUid', 'username', 'businessName', 'category', 'businessType', 'country', 'description', 'website', 'shopUrl', 'publicProofUrl', 'proofExplanation', 'ownerRole', 'supportEmail', 'fulfillment', 'contactEmail', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['ownerUid', 'username', 'businessName', 'category', 'businessType', 'country', 'description', 'website', 'shopUrl', 'publicProofUrl', 'proofExplanation', 'ownerRole', 'supportEmail', 'fulfillment', 'contactEmail', 'status', 'createdAt', 'updatedAt'])
        && data.businessName is string && data.businessName.size() >= 2 && data.businessName.size() <= 100
        && data.category in ['digital', 'physical', 'services', 'creator', 'other']
        && data.businessType in ['registered', 'sole_trader', 'creator', 'other']
        && data.country is string && data.country.size() >= 2 && data.country.size() <= 80
        && data.description is string && data.description.size() >= 20 && data.description.size() <= 1000
        && data.website is string && (data.website == '' || data.website.matches('^https?://.{1,296}$'))
        && data.shopUrl is string && data.shopUrl.matches('^https://(www[.])?user[.]pet/.{1,270}$') && data.shopUrl.size() <= 300
        && data.publicProofUrl is string && data.publicProofUrl.matches('^https://.{1,292}$') && data.publicProofUrl.size() <= 300
        && data.publicProofUrl != data.shopUrl
        && data.proofExplanation is string && data.proofExplanation.size() >= 30 && data.proofExplanation.size() <= 600
        && data.ownerRole in ['owner', 'co_owner', 'authorized_representative']
        && data.supportEmail is string && data.supportEmail.matches('^[^ @]+@[^ @]+[.][^ @]+$') && data.supportEmail.size() <= 254
        && data.fulfillment is string && data.fulfillment.size() >= 20 && data.fulfillment.size() <= 500;
    }

    match /businessApplications/{uid} {
      allow get: if siteMember() && request.auth.uid == uid;
      allow list: if false;
      allow create: if siteMember()
        && request.auth.uid == uid
        && validBusinessApplication(request.resource.data)
        && request.resource.data.ownerUid == uid
        && request.resource.data.username == get(/databases/$(database)/documents/users/$(uid)).data.username
        && request.resource.data.contactEmail == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if siteMember()
        && request.auth.uid == uid
        && resource.data.status in ['pending', 'rejected']
        && validBusinessApplication(request.resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.username == resource.data.username
        && request.resource.data.contactEmail == resource.data.contactEmail
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /verifiedBusinesses/{username} {
      allow get: if true;
      allow list, create, update, delete: if false;
    }

    function businessMember(id) {
      return signedIn()
        && exists(/databases/$(database)/documents/businesses/$(id))
        && request.auth.uid in get(/databases/$(database)/documents/businesses/$(id)).data.memberUids;
    }

    function businessEditor(id) {
      return businessMember(id)
        && get(/databases/$(database)/documents/businesses/$(id)).data.members[request.auth.uid].role in ['owner', 'manager', 'editor'];
    }

    match /businesses/{id} {
      allow get: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow list: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if siteMember()
        && request.resource.data.keys().hasOnly(['ownerUid', 'ownerUsername', 'name', 'description', 'category', 'website', 'status', 'memberUids', 'members', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['ownerUid', 'ownerUsername', 'name', 'description', 'category', 'website', 'status', 'memberUids', 'members', 'createdAt', 'updatedAt'])
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == id
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUsername == id
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.category in ['digital', 'physical', 'services', 'creator', 'other']
        && request.resource.data.website is string
        && request.resource.data.website.size() <= 300
        && request.resource.data.status == 'active'
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid].role == 'owner'
        && request.resource.data.members[request.auth.uid].email == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if siteMember()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'category', 'website', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.category in ['digital', 'physical', 'services', 'creator', 'other']
        && request.resource.data.website is string
        && request.resource.data.website.size() <= 300
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /businessShops/{id} { allow read, write: if false; }

    match /staffApplications/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || supportStaff());
      allow list: if supportStaff();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'area', 'motivation', 'experience', 'availability', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.area in ['support', 'trust_safety', 'marketplace', 'community', 'operations']
        && request.resource.data.motivation is string && request.resource.data.motivation.size() >= 30 && request.resource.data.motivation.size() <= 1000
        && request.resource.data.experience is string && request.resource.data.experience.size() >= 20 && request.resource.data.experience.size() <= 1000
        && request.resource.data.availability is string && request.resource.data.availability.size() >= 4 && request.resource.data.availability.size() <= 160
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn() && request.auth.uid == uid && resource.data.status in ['pending', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['area', 'motivation', 'experience', 'availability', 'status', 'updatedAt'])
        && request.resource.data.uid == uid && request.resource.data.email == resource.data.email
        && request.resource.data.area in ['support', 'trust_safety', 'marketplace', 'community', 'operations']
        && request.resource.data.motivation is string && request.resource.data.motivation.size() >= 30 && request.resource.data.motivation.size() <= 1000
        && request.resource.data.experience is string && request.resource.data.experience.size() >= 20 && request.resource.data.experience.size() <= 1000
        && request.resource.data.availability is string && request.resource.data.availability.size() >= 4 && request.resource.data.availability.size() <= 160
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /profileBadgeGrants/{username} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
    match /accessInvites/{email} {
      allow get: if (signedIn() && request.auth.token.email == email) || supportOwner();
      allow list: if supportOwner();
      allow create, update, delete: if false;
    }
    match /moderationProfiles/{username} {
      allow get: if true;
      allow list, create, update, delete: if false;
    }
    match /moderationCases/{username} {
      allow get, list: if supportStaff();
      allow create, update, delete: if false;
    }
    match /moderationAudit/{id} {
      allow get, list: if supportOwner();
      allow create, update, delete: if false;
    }

    match /supportStaff/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || supportOwner());
      allow list: if supportOwner();
      // Existing verified founders may bootstrap their own owner membership.
      // All later team changes are controlled by an active owner membership.
      allow create: if founder()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'role', 'capabilities', 'active', 'createdAt', 'addedBy'])
        && request.resource.data.uid == uid
        && request.resource.data.role == 'owner'
        && request.resource.data.active == true
        && request.resource.data.addedBy == uid
        && request.resource.data.createdAt == request.time;
      allow update: if supportOwner()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.role in ['owner', 'support_admin', 'support_agent', 'moderator']
        && request.resource.data.active is bool;
      allow delete: if false;
    }

    match /supportTickets/{ticketId} {
      allow get: if signedIn() && (resource.data.requesterUid == request.auth.uid || supportStaff());
      allow list: if signedIn()
        && request.query.limit != null
        && request.query.limit <= 51
        && (resource.data.requesterUid == request.auth.uid || supportStaff());
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['reference', 'requesterUid', 'requesterEmail', 'subject', 'category', 'status', 'priority', 'assignedToUid', 'tags', 'resolutionSummary', 'createdAt', 'updatedAt', 'lastPublicMessageAt'])
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.requesterEmail == request.auth.token.email
        && request.resource.data.reference is string
        && request.resource.data.reference.matches('^UP-[0-9]{4}-[A-Z0-9]{6}$')
        && request.resource.data.subject is string
        && request.resource.data.subject.size() >= 6
        && request.resource.data.subject.size() <= 120
        && request.resource.data.category in ['Account access', 'Profile editor', 'Bugs', 'Safety/Abuse', 'Marketplace', 'Payment issue', 'Other']
        && request.resource.data.status == 'open'
        && request.resource.data.priority == 'normal'
        && request.resource.data.assignedToUid == ''
        && request.resource.data.tags.size() == 0
        && request.resource.data.resolutionSummary == ''
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastPublicMessageAt == request.time;
      allow update: if signedIn()
        && request.resource.data.requesterUid == resource.data.requesterUid
        && request.resource.data.requesterEmail == resource.data.requesterEmail
        && request.resource.data.reference == resource.data.reference
        && request.resource.data.createdAt == resource.data.createdAt
        && ((resource.data.requesterUid == request.auth.uid
          && resource.data.status != 'closed'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'lastPublicMessageAt'])
          && (request.resource.data.status == resource.data.status || (resource.data.status == 'resolved' && request.resource.data.status == 'open')))
          || (supportStaff()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'priority', 'assignedToUid', 'category', 'tags', 'resolutionSummary', 'updatedAt', 'lastPublicMessageAt'])
            && request.resource.data.status in ['open', 'in_progress', 'waiting_on_user', 'resolved', 'closed']
            && request.resource.data.priority in ['low', 'normal', 'high', 'urgent']))
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      match /messages/{messageId} {
        function ticketAfter() {
          return getAfter(/databases/$(database)/documents/supportTickets/$(ticketId)).data;
        }
        allow get: if signedIn()
          && (supportStaff() || (ticketAfter().requesterUid == request.auth.uid && resource.data.visibility == 'public'));
        allow list: if signedIn()
          && request.query.limit != null
          && request.query.limit <= 101
          && (supportStaff() || (ticketAfter().requesterUid == request.auth.uid && resource.data.visibility == 'public'));
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['authorUid', 'authorRole', 'visibility', 'body', 'attachments', 'createdAt', 'editedAt'])
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() >= 1
          && request.resource.data.body.size() <= 5000
          && request.resource.data.attachments.size() == 0
          && request.resource.data.createdAt == request.time
          && ((ticketAfter().requesterUid == request.auth.uid
            && request.resource.data.authorRole == 'user'
            && request.resource.data.visibility == 'public')
            || (supportStaff()
              && request.resource.data.authorRole == supportMembership().role
              && request.resource.data.visibility in ['public', 'internal']));
        allow update, delete: if false;
      }

      match /audit/{auditId} {
        function auditTicket() {
          return getAfter(/databases/$(database)/documents/supportTickets/$(ticketId)).data;
        }
        allow get, list: if supportStaff();
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['actorUid', 'action', 'changes', 'createdAt'])
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && (supportStaff() || (auditTicket().requesterUid == request.auth.uid && request.resource.data.action in ['ticket_created', 'public_reply_added']));
        allow update, delete: if false;
      }
    }

    match /helpArticles/{articleId} {
      allow get, list: if resource.data.status == 'published' || supportStaff();
      allow create, update: if supportStaff()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status in ['draft', 'review', 'published', 'archived'];
      allow delete: if supportOwner();
    }

    match /helpCategories/{categoryId} {
      allow get, list: if resource.data.published == true || supportStaff();
      allow create, update, delete: if supportOwner();
    }

    match /helpLegalDocuments/{slug} {
      allow get, list: if resource.data.approved == true || supportStaff();
      allow create, update: if supportOwner();
      allow delete: if false;
    }

    match /helpFeedback/{feedbackId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow get, list, update, delete: if supportStaff();
    }

  }
}
