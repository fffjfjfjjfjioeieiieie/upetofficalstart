rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validUsername(username) {
      return username is string
        && username.matches('^[a-z0-9][a-z0-9._-]{2,19}$');
    }

    match /usernames/{username} {
      // Public availability checks are allowed; enumerating all handles is not.
      allow get: if signedIn();
      allow list: if false;

      // A claim and its account profile must be created together in one transaction.
      allow create: if signedIn()
        && validUsername(username)
        && request.resource.data.keys().hasOnly(['uid', 'username', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'username', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;

      // Handles are permanent; clients cannot transfer or delete them.
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'username', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['uid', 'username', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == uid
        && validUsername(request.resource.data.username)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;

      // Account identifiers stay fixed while profile editing is being built.
      allow update, delete: if false;
    }

    match /profiles/{username} {
      allow get: if true;
      allow list: if false;

      allow create: if signedIn()
        && validUsername(username)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;

      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.username == resource.data.username;

      allow delete: if false;
    }

  }
}
