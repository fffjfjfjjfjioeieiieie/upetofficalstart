rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function founder() {
      return signedIn()
        && request.auth.token.email in [
          'zurihcs@gmail.com',
          'lampjustlamp123@gmail.com',
          'iamjayvonlol@gmail.com',
          'riotsoffical@proton.me',
          'daalt38@gmail.com'
        ];
    }

    function validUsername(username) {
      return username is string
        && username.matches('^[a-z0-9][a-z0-9._-]{2,19}$')
        && !(username in ['dashboard', 'customize', 'analytics', 'settings', 'claim', 'welcome', 'create-account', 'login', 'admin', 'api', 'assets'])
        && (username != 'dome' || request.auth.token.email == 'zurihcs@gmail.com');
    }

    match /usernames/{username} {
      // Public availability checks are allowed; enumerating all handles is not.
      allow get: if founder();
      allow list: if false;

      // A claim and its account profile must be created together in one transaction.
      allow create: if founder()
        && validUsername(username)
        && request.resource.data.keys().hasOnly(['uid', 'username', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'username', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;

      // Handles are permanent; clients cannot transfer or delete them.
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow get: if founder() && request.auth.uid == uid;
      allow list: if false;

      allow create: if founder()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'role', 'username', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['uid', 'email', 'role', 'username', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'founder'
        && validUsername(request.resource.data.username)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;

      // Owners may repair legacy account metadata, but cannot transfer a handle.
      allow update: if founder()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'role', 'username', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.username == resource.data.username
        && request.resource.data.createdAt == resource.data.get('createdAt', request.time)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'founder'
        && request.resource.data.updatedAt == request.time
        && get(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;
      allow delete: if false;
    }

    match /profiles/{username} {
      // Drafts now live in owner-only profileDrafts. Legacy documents that still
      // contain a draft stay private until their owner republishes them.
      allow get: if !exists(/databases/$(database)/documents/profiles/$(username))
        || !('draft' in resource.data)
        || (founder() && (resource.data.get('ownerUid', '') == request.auth.uid || resource.data.get('uid', '') == request.auth.uid));
      allow list: if false;

      allow create: if founder()
        && validUsername(username)
        && request.resource.data.keys().hasOnly(['schemaVersion', 'ownerUid', 'username', 'status', 'published', 'publishedAt', 'updatedAt', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.username == username
        && request.resource.data.status == 'published'
        && request.resource.data.schemaVersion == 1
        && request.resource.data.published.schemaVersion == 1
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;

      allow update: if founder()
        && (resource.data.get('ownerUid', '') == request.auth.uid || resource.data.get('uid', '') == request.auth.uid)
        && request.resource.data.keys().hasOnly(['schemaVersion', 'ownerUid', 'username', 'status', 'published', 'publishedAt', 'updatedAt', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.username == username
        && request.resource.data.status == 'published'
        && request.resource.data.schemaVersion == 1
        && request.resource.data.published.schemaVersion == 1
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;

      allow delete: if false;
    }

    match /profileDrafts/{uid} {
      allow get: if founder() && request.auth.uid == uid;
      allow list: if false;
      allow create, update: if founder()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['schemaVersion', 'ownerUid', 'username', 'document', 'updatedAt'])
        && request.resource.data.ownerUid == uid
        && request.resource.data.username == get(/databases/$(database)/documents/users/$(uid)).data.username
        && request.resource.data.schemaVersion == 1
        && request.resource.data.document.schemaVersion == 1;
      allow delete: if founder() && request.auth.uid == uid;
    }

    match /profileEvents/{username}/events/{eventId} {
      allow get, list: if founder()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;
      allow create: if exists(/databases/$(database)/documents/profiles/$(username))
        && request.resource.data.keys().hasOnly(['kind', 'linkId', 'day', 'device', 'referrer', 'createdAt'])
        && request.resource.data.kind in ['view', 'click']
        && request.resource.data.linkId is string
        && request.resource.data.linkId.size() <= 80
        && request.resource.data.day is string
        && request.resource.data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.device in ['mobile', 'desktop']
        && request.resource.data.referrer is string
        && request.resource.data.referrer.size() <= 100
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /profileRevisions/{username}/revisions/{revisionId} {
      allow get, list: if founder()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;
      allow create: if founder()
        && request.resource.data.keys().hasOnly(['schemaVersion', 'ownerUid', 'username', 'document', 'publishedAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.username == username
        && request.resource.data.schemaVersion == 1
        && request.resource.data.document.schemaVersion == 1
        && getAfter(/databases/$(database)/documents/profiles/$(username)).data.ownerUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /shopMessages/{messageId} {
      allow get, list: if founder()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == resource.data.ownerUsername;
      allow create: if exists(/databases/$(database)/documents/profiles/$(request.resource.data.ownerUsername))
        && request.resource.data.keys().hasOnly(['ownerUsername', 'senderName', 'senderContact', 'body', 'read', 'createdAt'])
        && request.resource.data.ownerUsername is string
        && request.resource.data.ownerUsername.size() >= 3
        && request.resource.data.ownerUsername.size() <= 20
        && request.resource.data.senderName is string
        && request.resource.data.senderName.size() >= 1
        && request.resource.data.senderName.size() <= 80
        && request.resource.data.senderContact is string
        && request.resource.data.senderContact.size() <= 240
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 1
        && request.resource.data.body.size() <= 2000
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time;
      allow update: if founder()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == resource.data.ownerUsername
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;
      allow delete: if false;
    }

    match /shopConversations/{conversationId} {
      allow get: if founder()
        && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == resource.data.ownerUsername
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == resource.data.guestUsername);
      allow list: if founder()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == resource.data.ownerUsername;
      allow create: if founder()
        && exists(/databases/$(database)/documents/profiles/$(request.resource.data.ownerUsername))
        && request.resource.data.keys().hasOnly(['ownerUsername', 'guestUsername', 'guestName', 'guestContact', 'lastMessage', 'lastSender', 'unreadForOwner', 'unreadForGuest', 'createdAt', 'updatedAt'])
        && request.resource.data.ownerUsername is string
        && validUsername(request.resource.data.guestUsername)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == request.resource.data.guestUsername
        && request.resource.data.guestName is string
        && request.resource.data.guestName.size() >= 1
        && request.resource.data.guestName.size() <= 80
        && request.resource.data.guestContact is string
        && request.resource.data.guestContact.size() <= 240
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() >= 1
        && request.resource.data.lastMessage.size() <= 2000
        && request.resource.data.lastSender == 'guest'
        && request.resource.data.unreadForOwner == true
        && request.resource.data.unreadForGuest == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastSender', 'unreadForOwner', 'unreadForGuest', 'updatedAt'])
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() >= 1
        && request.resource.data.lastMessage.size() <= 2000
        && request.resource.data.lastSender in ['guest', 'owner']
        && request.resource.data.updatedAt == request.time
        && founder()
        && (request.resource.data.lastSender == 'guest'
          ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == resource.data.guestUsername
          : get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == resource.data.ownerUsername);
      allow delete: if false;

      match /messages/{messageId} {
        allow get, list: if founder()
          && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == get(/databases/$(database)/documents/shopConversations/$(conversationId)).data.ownerUsername
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == get(/databases/$(database)/documents/shopConversations/$(conversationId)).data.guestUsername);
        allow create: if request.resource.data.keys().hasOnly(['sender', 'body', 'createdAt'])
          && request.resource.data.sender in ['guest', 'owner']
          && request.resource.data.body is string
          && request.resource.data.body.size() >= 1
          && request.resource.data.body.size() <= 2000
          && request.resource.data.createdAt == request.time
          && founder()
          && (request.resource.data.sender == 'guest'
            ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == get(/databases/$(database)/documents/shopConversations/$(conversationId)).data.guestUsername
            : get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == get(/databases/$(database)/documents/shopConversations/$(conversationId)).data.ownerUsername);
        allow update, delete: if false;
      }
    }

    match /directoryProfiles/{username} {
      // Public discovery contains only fields already displayed on published pages.
      allow get, list: if true;
      allow create, update: if founder()
        && validUsername(username)
        && request.resource.data.keys().hasOnly(['ownerUid', 'username', 'displayName', 'alias', 'avatar', 'badges', 'shop', 'updatedAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.username == username
        && request.resource.data.updatedAt == request.time
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;
      allow delete: if false;
    }

  }
}
